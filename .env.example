# ---------------------------------------------------------------------------
# SAMPARK — environment variable template
#
# Copy to .env and fill in locally.  .env is gitignored; this file is tracked.
# NEVER put a real key, secret or password in this file.
#
# NOTE: these variable NAMES are a Phase 0 proposal, not a settled contract.
# Nothing reads them yet. Confirm/rename before any code depends on them.
# ---------------------------------------------------------------------------

# --- Razorpay (Phase 0 exit criterion: test-mode payment link from code) -----
# Test mode only. Key id begins with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Anthropic (Phase 7: policy compiler; spec §9) --------------------------
ANTHROPIC_API_KEY=

# --- PostgreSQL 16 — the grant/audit ledger (Phase 1+; spec §7) -------------
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Redis — budget counters, reservations, TTLs (Phase 4; spec §7) ---------
REDIS_HOST=
REDIS_PORT=
