# ---------------------------------------------------------------------------
# SAMPARK — environment variable template
#
# Copy to .env and fill in locally.  .env is gitignored; this file is tracked.
# NEVER put a real key, secret or password in this file.
#
# NOTE: these variable NAMES are a Phase 0 proposal, not a settled contract.
# Nothing reads them yet. Confirm/rename before any code depends on them.
# ---------------------------------------------------------------------------

# --- Razorpay (Phase 0 exit criterion: test-mode payment link from code) -----
# Test mode only. Key id begins with rzp_test_.
# sampark/integrations/razorpay.py REFUSES any key id that is not rzp_test_*.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Razorpay MCP Server (product integration, preferred transport) ----------
# The Razorpay MCP Server endpoint and its bearer token. When RAZORPAY_MCP_TOKEN
# is set, sampark/integrations/gateway.py PREFERS MCP for every Razorpay
# operation and the product surface labels it as such; when it is absent, the
# REST test API is used instead and the surface says so. Never both labels.
#
# Before any MCP *write*, the gateway performs a read-only cross-check that the
# MCP credential and the rzp_test_ REST key see the same payment-link ledger,
# which is what makes the "Test Mode" claim about the MCP path checkable rather
# than assumed. On a brand-new test account with no links to compare, set
# RAZORPAY_MCP_SKIP_LEDGER_CHECK=1 to proceed deliberately.
RAZORPAY_MCP_URL=
RAZORPAY_MCP_TOKEN=
RAZORPAY_MCP_SKIP_LEDGER_CHECK=

# --- Razorpay webhook (product integration) ----------------------------------
# The webhook secret configured in the Razorpay Dashboard. The receiver at
# POST /api/integrations/razorpay/webhook verifies HMAC-SHA256 over the RAW
# request body against this value and REFUSES (401) any body it cannot verify.
# Without it, the webhook path is unavailable; the polling path still works.
RAZORPAY_WEBHOOK_SECRET=

# --- Razorpay product demo amount (whole rupees, default 1000) ---------------
RAZORPAY_DEMO_AMOUNT_INR=

# --- Anthropic (Phase 7: policy compiler; spec §9) --------------------------
ANTHROPIC_API_KEY=

# --- PostgreSQL 16 — the grant/audit ledger (Phase 1+; spec §7) -------------
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Redis — budget counters, reservations, TTLs (Phase 4; spec §7) ---------
REDIS_HOST=
REDIS_PORT=
